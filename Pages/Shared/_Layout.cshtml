@using Models
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - hw</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/hw.styles.css" asp-append-version="true" />
</head>

<body class="d-flex flex-column vh-100 overflow-hidden mb-0">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-page="/Index">hw</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Privacy</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial.cshtml" />
                </div>
            </div>
        </nav>
    </header>
    @{
    var sidebarActiveKey = ViewData["SidebarActiveKey"]?.ToString();
    var selectedImageMetadata = ViewData["SelectedImageMetadata"] as ImageMetadata;
    }
    <div class="container-fluid flex-grow-1 d-flex flex-column overflow-hidden">
        <div class="row flex-nowrap h-100">
            <div class="col-2 d-flex flex-column p-0 h-100">
                <div class="d-flex flex-column h-100">
                    @await Html.PartialAsync("_Sidebar", new SidebarModel(sidebarActiveKey, selectedImageMetadata))
                </div>
            </div>
            <div class="col d-flex flex-column h-100 overflow-hidden">
                <main role="main" class="flex-grow-1 overflow-hidden">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
