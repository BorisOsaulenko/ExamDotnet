@model SidebarModel

@{
var activeKey = Model?.ActiveKey ?? string.Empty;
var links = new[]
{
new { Key = "home", Label = "Home", Url = Url.Page("/Index") ?? "/Index" },
new { Key = "my-images", Label = "My Images", Url = "/image/mine" },
new { Key = "my-collections", Label = "My Collections", Url = "/collections/mine" },
};
}

<style>
    #sidebar {
        position: sticky;
        left: 0;
        top: 0;
        height: 100vh;
        padding: 0;
        padding-top: 1rem;
        margin: 0;
        border: none;
        border-right: 1px solid var(--bs-border-color);
    }

    .list-group-item {
        border: none;
    }

    .list-group-item:hover {
        background-color: var(--bs-light);
        transition: 200ms;
    }

    #image-preview-container>div {
        opacity: 0;
        transition: 200ms;
    }

    #image-preview-container:hover>div {
        opacity: 1;
        transition: 200ms;
    }
</style>

@if (Model.SelectedImageMetadata == null) {
<div id="sidebar">
    <ul class="list-group list-group-flush">
        @foreach (var link in links)
        {
        var isActive = string.Equals(link.Key, activeKey, StringComparison.OrdinalIgnoreCase);
        <li class="list-group-item">
            @if (isActive)
            {
            <span class="d-block fw-semibold text-primary" aria-current="page">@link.Label</span>
            }
            else
            {
            <a class="text-decoration-none text-reset d-block" href="@link.Url">
                @link.Label
            </a>
            }
        </li>
        }
    </ul>
</div>
}
else {
<div class="text-center" style="padding: 0.75rem;" id="sidebar">
    <div class="d-flex align-items-center justify-content-between mb-2">
        <button type="button" class="btn btn-link text-decoration-none text-muted p-0" title="Clear selection" aria-label="Clear selection" style="outline: none; box-shadow: none;" onfocus="this.blur()" data-clear-selected-image>
            <span aria-hidden="true">&times;</span>
        </button>
        <div class="fw-semibold flex-grow-1 text-truncate" style="text-align: right;">
            @Model.SelectedImageMetadata.Title
        </div>
    </div>

    <div style="position: relative;" id="image-preview-container">
        <img src="@Model.SelectedImageMetadata.Image.BlobUri" class="img-fluid rounded" style="width: 100%;" alt="@(Model.SelectedImageMetadata.Title ?? " Selected image")" />
        <div class="d-flex gap-2" style="justify-content: space-between; position: absolute; bottom: 0; left: 0; right: 0; z-index: 1; padding: 0.5rem; background-color: rgba(0, 0, 0, 0.5);">
            <button id="likeButton" style="background: transparent; outline: none; border: none;">
                <i class="fa-solid fa-heart" style="color: rgba(255, 0, 0, 0.7);"></i>
            </button>
            <button id="shareButton" style="background: transparent; outline: none; border: none;">
                <i class="fa-solid fa-share" style="color: rgba(255, 255, 255, 0.7);"></i>
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SelectedImageMetadata.Description))
    {
    <p class="text-muted small mt-2" style="text-align: left;">@Model.SelectedImageMetadata.Description</p>
    }
</div>
<script>
    document.addEventListener("click", (event) => {
        const clearButton = event.target.closest("[data-clear-selected-image]");
        if (!clearButton) {
            return;
        }

        event.preventDefault();
        const url = new URL(window.location.href);
        url.searchParams.delete("SelectedImageId");
        window.location.href = url.toString();
    });

    document.getElementById("likeButton").addEventListener("click", () => {
        const imageId = "@Model.SelectedImageMetadata.Id";
        fetch(`/api/image/${imageId}/likes/toggle`, { method: "POST" }); // just a like, dont care about response
    });
    document.getElementById("shareButton").addEventListener("click", async () => {
        if (navigator.share) {
            try {
                await navigator.share({
                    title: "@Model.SelectedImageMetadata.Title",
                    text: "Check out this image!",
                    url: `http://localhost:5016/Index?Filter.SearchTerm=${encodeURIComponent("@Model.SelectedImageMetadata.Title")}`
                });
            } catch (err) {
                console.error("Share canceled/failed", err);
            }
        } else {
            // fallback (e.g., display custom modal)
        }
    });
</script>
}